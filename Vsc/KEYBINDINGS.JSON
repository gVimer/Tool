//将键绑定放在此文件中以覆盖默认值
[
    {
        "Desc"    : "查看:聚焦于第一个编辑器组",
        "key"     : "CTRL+1",
        "command" : "-workbench.action.focusFirstEditorGroup"
    },
    {
        "Desc"    : "查看:切换终端",
        "key"     : "CTRL+OEM_3",
        "command" : "-workbench.action.terminal.toggleTerminal",
        "when"    : "terminal.active"
    },
    {
        "Desc"    : "查看:缩小",
        "key"     : "CTRL+OEM_MINUS",
        "command" : "-workbench.action.zoomOut"
    },
    {
        "Desc"    : "查看:缩小",
        "key"     : "CTRL+SHIFT+OEM_MINUS",
        "command" : "-workbench.action.zoomOut"
    },
    {
        "Desc"    : "查看:放大",
        "key"     : "CTRL+OEM_PLUS",
        "command" : "-workbench.action.zoomIn"
    },
    {
        "Desc"    : "查看:放大",
        "key"     : "CTRL+SHIFT+OEM_PLUS",
        "command" : "-workbench.action.zoomIn"
    },
    {
        "Desc"    : "查看:切换面板可见性",
        "key"     : "CTRL+J",
        "command" : "-workbench.action.togglePanel"
    },
    {
        "Desc"    : "",
        "key"     : "CTRL+X",
        "command" : "-extension.vim_ctrl+x",
        "when"    : "editorTextFocus && vim.active && vim.use<C-x> && !inDebugRepl"
    },
    {
        "Desc"    : "查看:显示资源管理器",
        "key"     : "CTRL+SHIFT+E",
        "command" : "-workbench.view.explorer",
        "when"    : "viewContainer.workbench.view.explorer.enabled"
    },

    {
        "Desc"    : "TurboConsoleLog: CommentTurboLogMessages",
        "key"     : "SHIFT+ALT+C",
        "command" : "-turboConsoleLog.commentAllLogMessages"
    },
 
    {
        "Desc"    : "打开资源管理中的下一个文件",
        "key"     : "ALT+1",
        "command" : "runCommands",
        "args"    : {
            "commands": [
              "workbench.view.explorer",
              "list.focusDown",
              "list.select",
              "workbench.action.focusActiveEditorGroup"
            ]
        }
    },
    {
        "Desc"    : "打开资源管理中的上一个文件",
        "key"     : "ALT+2",
        "command" : "runCommands",
        "args"    : {
            "commands": [
              "workbench.view.explorer",
              "list.focusUp",
              "list.select",
              "workbench.action.focusActiveEditorGroup"
            ]
        }
    },
    {
        "Desc"    : "查看:切换终端",
        "key"     : "ALT+=",
        "command" : "workbench.action.terminal.toggleTerminal",
        "when"    : "terminal.active"
    },
    {
        "Desc"    : "对齐操作",
        "key"     : "ALT+A",
        "command" : "vscode-better-align.align"
    },
    {
        "Desc"    : "显示所有命令",
        "key"     : "ALT+P",
        "command" : "workbench.action.showCommands"
    },
    {
        "Desc"     : "将光标下的单词作为文件名进行搜索",
        "key"      : "ALT+S",
        "command"  : "runCommands",
        "args"     : {
            "commands" : [
                "editor.action.addSelectionToNextFindMatch", 
                "editor.action.clipboardCopyAction",
                "workbench.action.quickOpen",
                "editor.action.clipboardPasteAction"
             ]
        },
        "when": "editorTextFocus"
    },
    {
        "Desc"    : "查看:显示资源管理器",
        "key"     : "CTRL+1",
        "command" : "workbench.view.explorer",
        "when"    : "viewContainer.workbench.view.explorer.enabled"
    },
    {
        "Desc"    : "首选项:打开用户设置(JSON)",
        "key"     : "CTRL+'",
        "command" : "workbench.action.openSettingsJson",
        "when"    : "editorTextFocus"
    },
    {
        "Desc"    : "返回",
        "key"     : "CTRL+-",
        "command" : "workbench.action.navigateBack",
        "when"    : "canNavigateBack"
    },
    {
        "Desc"    : "前进",
        "key"     : "CTRL+=",
        "command" : "workbench.action.navigateForward",
        "when"    : "canNavigateForward"
    },
    {
        "Desc"    : "在下面添加光标",
        "key"     : "CTRL+DOWN",
        "command" : "editor.action.insertCursorBelow"
    },
    {
        "Desc"    : "在上面添加光标",
        "key"     : "CTRL+UP",
        "command" : "editor.action.insertCursorAbove"
    },
    {
        "Desc"    : "选择所有找到的查找匹配项(多行操作)",
        "key"     : "CTRL+A",
        "command" : "editor.action.selectHighlights",
        "when"    : "vim.active && editorFocus && vim.mode == 'Normal' || vim.mode == 'Visual' || vim.mode == 'VisualBlock' && !inDebugRepl"
    },
    {
        "Desc"    : "选择下一个",
        "key"     : "CTRL+J",
        "command" : "selectNextSuggestion",
        "when"    : "editorTextFocus && suggestWidgetMultipleSuggestions && suggestWidgetVisible"
    },
    {
        "Desc"    : "选择上一个",
        "key"     : "CTRL+K",
        "command" : "selectPrevSuggestion",
        "when"    : "editorTextFocus && suggestWidgetMultipleSuggestions && suggestWidgetVisible"
    },
    {
        "Desc"    : "在QuickOpen中选择'下一步'",
        "key"     : "CTRL+J",
        "command" : "workbench.action.quickOpenSelectNext",
        "when"    : "inQuickOpen"
    },
    {
        "Desc"    : "在QuickOpen中选择'上一步'",
        "key"     : "CTRL+K",
        "command" : "workbench.action.quickOpenSelectPrevious",
        "when"    : "inQuickOpen"
    },
    {
        "Desc"    : "将选择内容添加到下一个查找匹配项(多选)",
        "key"     : "CTRL+n",
        "command" : "editor.action.addSelectionToNextFindMatch",
        "when"    : "vim.active && editorFocus && vim.mode == 'Normal' || vim.mode == 'Visual' || vim.mode == 'VisualBlock' && !inDebugRepl"
    },
    {
        "Desc"    : "???",
        "key"     : "CTRL+X",
        "command" : "editor.action.moveSelectionToNextFindMatch",
        "when"    : "vim.active && editorFocus && vim.mode == 'Normal' || vim.mode == 'Visual' || vim.mode == 'VisualBlock' && !inDebugRepl"
    },
    {
        "Desc"    : "剪切",
        "key"     : "CTRL+X",
        "command" : "extension.vim_ctrl+x"
    },
    {
        "Desc"    : "指定关键字搜索",
        "key"     : "CTRL+ALT+C",
        "command" : "workbench.action.quickOpen",
        "args"    : "SGarden"
    },
    {
        "Desc"    : "撤销",
        "key"     : "CTRL+Z",
        "command" : "undo"
    }, 
    {
        "Desc"    : "重做",
        "key"     : "CTRL+R",
        "command" : "redo"
    },
    {
        "Desc"    : "转到文件中的上一个问题(错误、警告、信息)",
        "key"     : "SHIFT+F1",
        "command" : "runCommands",
        "when"    : "editorFocus",
        "args"    : {
          "commands": [
            "editor.action.marker.prevInFiles"
          ]
        }
    },
    {
        "Desc"    : "转到文件中的下一个问题(错误、警告、信息)",
        "key"     : "F1",
        "command" : "runCommands",
        "when"    : "editorFocus",
        "args"    : {
            "commands": [
              "editor.action.marker.nextInFiles"
            ]
        }
    },
    {
        "Desc"    : "复制文件名合扩展名",
        "key"     : "F1",
        "command" : "copy-file-name.copyFileNameWithExtension"
    },
    {
        "Desc"    : "查找",
        "key"     : "F3",
        "command" : "actions.find"
    },

    {
        "Desc"    : "全局搜索光标下的单词",
        "key"     : "F5",
        "command" : "runCommands",
        "when"    : "editorTextFocus",
        "args"    : {
            "commands": [
                //"workbench.action.pinEditor",
                //"editor.action.selectHighlights",//会复制所有高亮的
                "references-view.clear",
                "cursorWordStartLeft",
                "cursorWordEndRightSelect",
                "extension.vim_escape",
                "editor.action.clipboardCopyAction",
                "workbench.action.findInFiles",
                "editor.action.clipboardPasteAction",
                "workbench.action.files.save"
            ]
        }
    },
    {
        "Desc"    : "引用:查找所有引用",
        "key"     : "F6",
        "command" : "references-view.findReferences"
    },
    {
        "Desc"    : "查看:切换主侧栏可见性",
        "key"     : "F7",
        "command" : "runCommands",
        "args"    : {
            "commands": [
                "workbench.action.toggleSidebarVisibility"
            ]
        }
    },
    {
        "Desc"    : "将选择内容添加到下一个查找匹配项=>终端:复制所选内容",
        "key"     : "F8",
        "command" : "runCommands",
        "args"    : {
            "commands": [
                "editor.action.addSelectionToNextFindMatch",
                "workbench.action.terminal.copySelection"
            ]
        }
    },
    {
        "Desc"    : "文件:在Finder中显示",
        "key"     : "F9",
        "command" : "revealFileInOS"
    },
    {
        "Desc"    : "查看:固定编辑器=>查看:关闭所有编辑器",
        "key"     : "F12",
        "command" : "runCommands",
        "when"    : "editorTextFocus",
        "args"    : {
            "commands": [
                "workbench.action.pinEditor",
                "workbench.action.closeAllEditors"
            ]
        }
    }
]
